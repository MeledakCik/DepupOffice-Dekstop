<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DepupOffice</AssemblyName>
    <RootNamespace>DepupOfficeDesktop</RootNamespace>
    <Version>2.3.0</Version>
    <Company>Depup Cloud</Company>
    <Product>Depup Office Desktop v2.3.0</Product>
    <Description>Depup Office Desktop v2.3.0 - FREE, 100% Offline, Zero Cloud Upload. Donasi sukarela via https://saweria.co/depupdonate (tidak membuka fitur premium, diproses di luar aplikasi)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="privacy.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <Target Name="CopyPrivacyHtmlToDocuments" AfterTargets="Build;Publish">
    <MakeDir Directories="$(UserProfile)\Documents\DepupOffice" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)privacy.html" DestinationFolder="$(UserProfile)\Documents\DepupOffice" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
