<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DepupOffice</AssemblyName>
    <ApplicationIcon>Assets\depup.ico</ApplicationIcon>
    <RootNamespace>DepupOfficeDesktop</RootNamespace>
    <Version>4.4.3</Version>
    <Company>Depup Cloud</Company>
    <Product>Depup Office Desktop v4.4.3</Product>
    <Description>Depup Office Desktop v4.4.3 - FREE, Offline, Zero Cloud Upload. Donasi sukarela via https://saweria.co/depupdonate (tidak membuka fitur premium, diproses di luar aplikasi)</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\depup.ico" LogicalName="DepupOfficeDesktop.depup.ico" />
    <InternalsVisibleTo Include="DepupOfficeDesktop.Tests" />
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="privacy.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <Target Name="CopyPrivacyHtmlToDocuments" AfterTargets="Build;Publish">
    <MakeDir Directories="$(UserProfile)\Documents\DepupOffice" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)privacy.html" DestinationFolder="$(UserProfile)\Documents\DepupOffice" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
