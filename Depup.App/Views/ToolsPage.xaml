<UserControl x:Class="Depup.App.Views.ToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Peralatan PDF &amp; Dokumen" Style="{StaticResource DisplayText}" />
        <TextBlock Text="Pengolahan PDF lokal tanpa mengunggah dokumen." Style="{StaticResource MutedText}" Margin="0,8,0,24" />
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Operasi PDF" Style="{StaticResource Heading2}" Margin="0,0,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding PdfTool.Operations}" SelectedItem="{Binding PdfTool.SelectedOperation}" Height="40" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding PdfTool.OutputPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Lokasi berkas hasil" Style="{StaticResource InputStyle}" Margin="0,0,10,0" />
                    <Button Grid.Column="2" Content="Tambah PDF" Command="{Binding PdfTool.AddFileCommand}" Style="{StaticResource SecondaryButton}" />
                </Grid>
                <TextBox Text="{Binding PdfTool.Options, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,10,0,0" ToolTip="Halaman (contoh: 1-3,5), derajat rotasi, atau kata sandi" />
                <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" MinHeight="100" Margin="0,14,0,10" AllowDrop="True" DragOver="OnPdfDragOver" Drop="OnPdfDrop" Background="{StaticResource CanvasBrush}">
                    <TextBlock Text="Seret PDF ke sini (maksimal 50 MB per file)" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding PdfTool.InputFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DocumentRowStyle}" Padding="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Hapus" Command="{Binding DataContext.PdfTool.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Value="{Binding PdfTool.Progress}" Maximum="1" Height="8" Margin="0,12,0,8" />
                <Grid>
                    <TextBlock Text="{Binding PdfTool.StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Batal" Command="{Binding PdfTool.CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="Proses" Command="{Binding PdfTool.ExecuteCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PdfTool.LastOutputPath}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
