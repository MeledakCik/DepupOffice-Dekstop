<UserControl x:Class="Depup.App.Views.SavePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Simpan &amp; Keamanan" Style="{StaticResource DisplayText}" />
        <TextBlock Text="Dokumen tetap berada di perangkat Anda." Style="{StaticResource MutedText}" Margin="0,8,0,24" />
        <Border Style="{StaticResource EmptyStateCardStyle}" MinHeight="220">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <TextBlock Text="Penyimpanan lokal" Style="{StaticResource Heading2}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="Folder dokumen, riwayat, dan Vault akan ditampilkan di sini setelah fiturnya tersedia." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
